<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leap Year Scanner</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Orbitron', sans-serif;
            background: #0f0c29; /* Fallback for old browsers */
            background: -webkit-linear-gradient(to right, #24243e, #302b63, #0f0c29);
            background: linear-gradient(to right, #24243e, #302b63, #0f0c29);
        }
        .text-glow { text-shadow: 0 0 8px rgba(0, 255, 255, 0.7); }
        .button-glow:hover { box-shadow: 0 0 15px rgba(0, 220, 255, 0.7); }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-4">

    <div class="w-full max-w-md bg-black/30 backdrop-blur-xl rounded-2xl border border-cyan-300/20 shadow-2xl p-8">
        
        <h1 class="text-3xl font-bold text-center text-cyan-300 text-glow mb-8">LEAP YEAR SCANNER</h1>

        <div class="flex gap-4">
            <input type="number" id="yearInput" placeholder="[ ENTER YEAR ]" class="w-full px-4 py-3 bg-slate-900/80 border-2 border-cyan-400/50 rounded-lg text-cyan-300 placeholder-cyan-500/60 focus:outline-none focus:ring-2 focus:ring-cyan-300 transition" onkeydown="if(event.key === 'Enter') checkLeapYear()">
            <button onclick="checkLeapYear()" class="px-6 py-3 bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-bold rounded-lg button-glow transition">ANALYZE</button>
        </div>

        <p id="result" class="text-center text-xl font-medium tracking-wider mt-8 pt-6 min-h-[4rem] border-t-2 border-cyan-300/10"></p>
    </div>

    <script>
        function checkLeapYear() {
            const year = parseInt(yearInput.value);
            const resultEl = document.getElementById("result");

            if (isNaN(year)) {
                resultEl.className = "text-center text-xl font-medium tracking-wider mt-8 pt-6 min-h-[4rem] border-t-2 border-cyan-300/10 text-fuchsia-500";
                resultEl.innerText = "INVALID INPUT";
                return;
            }

            const isLeap = (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);
            
            resultEl.innerText = isLeap ? `[ ${year} // LEAP YEAR // CONFIRMED ]` : `[ ${year} // STANDARD YEAR // DETECTED ]`;
            resultEl.className = isLeap 
                ? "text-center text-xl font-medium tracking-wider mt-8 pt-6 min-h-[4rem] border-t-2 border-cyan-300/10 text-lime-400 text-glow" 
                : "text-center text-xl font-medium tracking-wider mt-8 pt-6 min-h-[4rem] border-t-2 border-cyan-300/10 text-fuchsia-500";
        }
    </script>
</body>
</html>
